# Kopyala: cp .env.example .env.local  (.env.local git'e girmez)

# Google Cloud Console → Places API (New) etkin bir anahtar.
# scripts/find-leads.mts kullanır. Bütçe uyarısı kurmayı unutma.
GOOGLE_PLACES_API_KEY=

# Sitenin canlı adresi (og:image mutlak URL için). Vercel'de otomatik; alan adı bağlanınca burayı yaz.
NEXT_PUBLIC_SITE_URL=

# PostHog (eu.posthog.com → Project settings → Project API key, "phc_..." ile başlar).
# Boşsa hiçbir şey yüklenmez. Oturum kaydı + scroll/CTA sinyalleri için.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_INGEST=https://eu.i.posthog.com

# Claude API — scripts/draft-site.mts (Maps metninden site taslağı). console.anthropic.com
ANTHROPIC_API_KEY=
# Taslak üreticinin teklif alanları
SELLER_WHATSAPP=
OFFER_PRICE=8500

# Satış otomasyonu — scripts/sell.mts. Vercel → Settings → Tokens; proje id Settings → General.
DARPHANE_VERCEL_TOKEN=
DARPHANE_VERCEL_PROJECT_ID=
DARPHANE_VERCEL_TEAM_ID=

# Panel girişi (/giris → /panel). Vercel env olarak gir; repo'ya yazma.
DARPHANE_ADMIN_PASSWORD=

# Panelin canlıda kaydedebilmesi için: GitHub fine-grained token (Serdaf123 → Settings →
# Developer settings → Fine-grained tokens; yalnız Darphane repo, Contents: Read and write).
# Yoksa panel salt okunur değil ama yerel dosyaya yazar; Vercel'de o dosya kalıcı olmaz.
DARPHANE_GITHUB_TOKEN=
# İsteğe bağlı: varsayılan Serdaf123/Darphane ve main
DARPHANE_GITHUB_REPO=
DARPHANE_GITHUB_BRANCH=

# Manus — scripts/manus.mts (brifi Manus'a verir, cevabı dosyaya yazar).
# manus.im → Settings → Integrations → API → Create API Key (bir kez gösterilir)
MANUS_API_KEY=

# PostHog → Telegram uyarı köprüsü (app/api/uyari). BotFather'dan bot, chat id için @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook URL'sindeki ?s= değeri; rastgele uzun bir dize
DARPHANE_WEBHOOK_SECRET=
